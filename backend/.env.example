# =============================================================================
# Variables de entorno del backend (Carta Digital)
# Copiar a `backend/.env` y completar con los valores reales del proyecto Supabase.
# NUNCA commitear el archivo .env con valores reales.
# =============================================================================

# URL del proyecto Supabase (Project Settings > API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública (anon) — segura para el cliente, respeta RLS
SUPABASE_ANON_KEY=tu-anon-key

# Clave de servicio (service_role) — BYPASSEA RLS. Solo backend/CLI/servidores.
# Jamás exponer en el frontend ni commitear.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Referencia del proyecto (el subdominio de SUPABASE_URL). Usado por `supabase link`.
SUPABASE_PROJECT_REF=tu-project-ref

# Contraseña de la base de datos (Project Settings > Database).
# Necesaria para `supabase db push` contra el proyecto remoto.
SUPABASE_DB_PASSWORD=tu-db-password
